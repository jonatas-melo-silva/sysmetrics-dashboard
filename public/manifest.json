{
  "manifest_version": 3,
  "name": "SysMetrics",
  "version": "1.0.0",
  "description": "Mostra os logs do sysmetrics servidos em 127.0.0.1.",
  "action": { "default_title": "Abrir SysMetrics" },
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://127.0.0.1:8765/*"]
}
